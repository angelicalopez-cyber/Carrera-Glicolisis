<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Carrera de la Glucólisis — Edición V4 Tablero Protagonista</title>
<style>
:root{--ink:#183247;--muted:#60758a;--accent:#147ea8;--gain:#168b68;--gold:#d49a18;--bg:#eef2f5;--bad:#b44b4b}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;overflow-x:hidden}
.wrap{max-width:1200px;margin:auto;padding:12px}
button,input{font:inherit}
.panel{background:#fff;border:1px solid #dbe2e8;border-radius:18px;padding:16px;box-shadow:0 6px 20px rgba(30,50,70,.06)}

/* PANTALLA INICIO */
#start{max-width:580px;margin:50px auto;text-align:center}
#start h1{margin-top:0;color:var(--accent);font-size:28px}
.field{display:flex;gap:8px;margin-top:20px}
.field input{flex:1;padding:12px;border:1px solid #cbd5e1;border-radius:12px;font-size:15px}
.primary{border:0;border-radius:10px;padding:12px 20px;background:var(--accent);color:#fff;font-weight:800;cursor:pointer;transition:all 0.2s}
.primary:hover{background:#0f6385;transform:scale(1.02)}
.secondary{border:1px solid #cbd5e1;background:#fff;border-radius:10px;padding:9px 14px;cursor:pointer;font-weight:700;color:var(--ink)}

/* JUEGO PRINCIPAL */
.game{display:none}
.top{display:flex;justify-content:space-between;gap:12px;align-items:center;background:#fff;padding:12px 20px;border-radius:16px;box-shadow:0 4px 15px rgba(0,0,0,0.05);margin-bottom:12px;position:sticky;top:8px;z-index:20}
.stats{display:flex;gap:10px;flex-wrap:wrap}
.stat{background:#f1f5f7;border-radius:10px;padding:6px 12px;font-size:13px;font-weight:700;display:flex;align-items:center;gap:4px}
.stat b{font-size:17px;color:var(--accent)}

/* MAPA CENTRAL PROTAGONISTA (75% ANCHO) */
.board-container{position:relative;width:100%;max-width:850px;margin:0 auto;background:#fff;border-radius:20px;padding:15px;box-shadow:0 8px 24px rgba(0,0,0,0.06);text-align:center}
.mapwrap{overflow:auto;background:radial-gradient(circle, #fbfcfd 0%, #eef3f7 100%);border-radius:16px;padding:10px;border:1px solid #e1e8ed}
.map{display:block;margin:auto;max-width:100%;height:auto;min-width:650px}

/* ELEMENTOS SVG */
.thread{fill:none;stroke:#c5cfd6;stroke-width:8;stroke-linecap:round}
.core{fill:none;stroke:#6da8bc;stroke-width:3;stroke-dasharray:8 8;stroke-linecap:round}
.pearl{fill:#f8fafb;stroke:#aebbc5;stroke-width:3;transition:all 0.3s}
.done .pearl{fill:#dff4ea;stroke:var(--gain)}
.current .pearl{fill:#e3f1f7;stroke:var(--accent);stroke-width:6;animation:pulse 1.8s infinite}
.meta .pearl{fill:#fff8df;stroke:var(--gold);stroke-width:5}
@keyframes pulse{0%{r:27}50%{r:32}100%{r:27}}

.node{cursor:pointer}
.node text{font-weight:800;fill:var(--ink);text-anchor:middle;dominant-baseline:middle;font-size:12px;pointer-events:none}
.node .small{font-size:9px;font-weight:700;fill:var(--muted)}
.phase{font-size:11px;font-weight:800;letter-spacing:.5px;fill:var(--muted)}
.enzyme{font-size:10px;font-weight:700;fill:#5d7180}
.token{fill:var(--accent);stroke:#fff;stroke-width:3;transition:all 0.5s ease-in-out}
.tokenText{fill:#fff;font-size:10px;font-weight:900;text-anchor:middle;dominant-baseline:middle;pointer-events:none}

.legend{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:10px}
.dot{width:10px;height:10px;border-radius:50%;display:inline-block;border:2px solid #aaa;vertical-align:-1px;margin-right:4px}

/* DOCK LATERAL EMERGENTE DE DESAFÍOS (SLIDE-IN SIN BLOQUEAR EL MAPA) */
.challenge-dock{position:fixed;bottom:20px;right:20px;width:340px;background:#fff;border:2px solid var(--accent);border-radius:18px;padding:16px;box-shadow:0 12px 30px rgba(0,0,0,0.18);z-index:100;transform:translateX(400px);transition:transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275)}
.challenge-dock.active{transform:translateX(0)}
.dock-header{display:flex;align-items:center;gap:8px;border-bottom:1px solid #edf2f7;padding-bottom:8px;margin-bottom:10px}
.dock-icon{font-size:20px}
.dock-title{font-size:12px;font-weight:900;color:var(--accent);text-transform:uppercase;letter-spacing:0.5px}
.dock-body{font-size:14px;font-weight:800;color:var(--ink);margin-bottom:10px;line-height:1.35}
.choices{display:grid;gap:6px}
.choice{border:1px solid #d6dee4;background:#f8fafc;border-radius:10px;padding:9px 12px;text-align:left;cursor:pointer;font-size:13px;font-weight:600;transition:all 0.15s}
.choice:hover:not(:disabled){background:#edf4f8;border-color:var(--accent)}
.choice.ok{background:#e4f6ed;border-color:var(--gain);color:#0d5942}
.choice.no{background:#fdeeee;border-color:var(--bad);color:#832525}
.feedback{font-size:12px;font-weight:700;margin-top:8px;min-height:24px}

/* PANTALLA FINAL */
.final{display:none;max-width:760px;margin:45px auto;text-align:center}
.results{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}
.result{background:#f1f6f7;border-radius:14px;padding:15px}
.result b{display:block;font-size:24px;color:var(--accent)}

@media(max-width:768px){
 .challenge-dock{width:calc(100% - 30px);left:15px;right:15px;bottom:15px}
}
</style>
</head>
<body>
<div class="wrap">

<!-- INICIO -->
<section id="start" class="panel">
<h1>🧬 Carrera de la Glucólisis V4</h1>
<p class="sub">Construye y recorre la vía metabólica directamente en el tablero. Alterna entre preguntas teóricas y colocación interactiva de moléculas y enzimas.</p>
<div class="field">
  <input id="name" maxlength="60" placeholder="Nombre del biomanauta...">
  <button class="primary" id="startBtn">Comenzar Travesía</button>
</div>
</section>

<!-- JUEGO PRINCIPAL -->
<section id="game" class="game">
<div class="top">
  <div>
    <h1 style="margin:0;font-size:18px;color:var(--accent)">CARRERA DE LA GLUCÓLISIS</h1>
    <div class="sub" id="student" style="font-weight:bold;font-size:12px"></div>
  </div>
  <div class="stats">
    <div class="stat">⏱️ <b id="time">00:00</b></div>
    <div class="stat">🔮 Perlas <b id="pearls">0</b></div>
    <div class="stat">⚡ ATP neto <b id="atp">0</b></div>
    <div class="stat">🧪 NADH <b id="nadh">0</b></div>
  </div>
</div>

<!-- EL MAPA CANVA/SVG CENTRAL ES EL PROTAGONISTA -->
<div class="board-container">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
    <h2 style="margin:0;font-size:16px;color:var(--ink)">Tablero Central de la Travesía</h2>
    <button class="secondary" id="canvaBtn" type="button" style="font-size:12px">🎨 Exportar / Ver Plantilla Canva (SVG)</button>
  </div>

  <div class="mapwrap">
    <svg class="map" viewBox="0 0 760 940" aria-label="Tablero de la glucólisis">
      <path class="thread" d="M380 82 V330"/>
      <path class="core" d="M380 82 V330"/>
      <path class="thread" d="M380 330 C300 380 210 390 210 455 V820"/>
      <path class="core" d="M380 330 C300 380 210 390 210 820"/>
      <path class="thread" d="M380 330 C460 380 550 390 550 455 V820"/>
      <path class="core" d="M380 330 C460 380 550 390 550 820"/>
      <text class="phase" x="380" y="35" text-anchor="middle">FASE DE INVERSIÓN · SE INVIERTEN 2 ATP</text>
      <text class="phase" x="380" y="365" text-anchor="middle">FASE DE GANANCIA · OCURRE 2×</text>
      <g id="nodes"></g>
      <g id="enzymes"></g>
      <g id="token"></g>
    </svg>
  </div>

  <div class="legend">
    <span><i class="dot" style="background:#f8fafb"></i>Pendiente</span>
    <span><i class="dot" style="background:#dff4ea;border-color:#168b68"></i>Completada</span>
    <span><i class="dot" style="background:#e3f1f7;border-color:#147ea8"></i>Posición TÚ</span>
    <span><i class="dot" style="background:#fff8df;border-color:#d49a18"></i>Meta Piruvato</span>
  </div>
</div>
</section>

<!-- TARJETA LATERAL EMERGENTE PARA PREGUNTAS Y RETOS DE COLOCACIÓN -->
<div class="challenge-dock" id="dock">
  <div class="dock-header">
    <div class="dock-icon" id="dockIcon">🧪</div>
    <div>
      <div class="dock-title" id="dockTitle">Desafío Emergente</div>
      <div style="font-size:10px;color:var(--muted)" id="dockSub">Paso de la travesía</div>
    </div>
  </div>
  <div class="dock-body" id="dockText">Cargando reto...</div>
  <div class="choices" id="dockChoices"></div>
  <div class="feedback" id="dockFeedback"></div>
  <button class="primary" id="dockNextBtn" style="display:none;width:100%;margin-top:10px">Continuar ➔</button>
</div>

<!-- PANTALLA FINAL -->
<section id="final" class="final panel">
  <h1>🏁 ¡Carrera Terminada!</h1>
  <p id="finalStudent" style="font-size:16px;font-weight:bold;color:var(--accent)"></p>
  <div class="results">
    <div class="result">Tiempo<b id="finalTime">00:00</b></div>
    <div class="result">Perlas Obtenidas<b id="finalPearls">0</b></div>
    <div class="result">Aciertos<b id="finalCorrect">0</b></div>
    <div class="result">Bonos Reto<b id="finalBonus">0</b></div>
    <div class="result">ATP Neto<b>2</b></div>
    <div class="result">NADH<b>2</b></div>
  </div>
  <button class="primary" id="restart" style="margin-top:10px">Jugar de nuevo</button>
</section>

</div>

<script>
/* SECUENCIA DINÁMICA SECUENCIAL: PREGUNTA -> MOLÉCULA/ENZIMA -> PREGUNTA -> ... */
const sequence=[
  {type:"q", text:"¿Dónde ocurre la glucólisis?", choices:["En el núcleo","En el citosol","En el lisosoma","En el aparato de Golgi"], correct:1, err:"No todavía. La glucólisis ocurre en el citosol."},
  {type:"place", item:"G6P", cat:"Molécula", hint:"Coloca Glucosa-6-Fosfato (G6P) inmediatamente después de la Hexocinasa.", validNodes:[1]},
  {type:"q", text:"¿La glucólisis requiere oxígeno de manera directa?", choices:["Sí","No","Solo al final","Solo durante la inversión"], correct:1, err:"Recordatorio: La glucólisis es anaerobia y ocurre sin necesidad directa de O2."},
  {type:"place", item:"F-1,6-BP", cat:"Molécula", hint:"Coloca Fructosa-1,6-Bisfosfato justo antes de la Ruptura.", validNodes:[3]},
  {type:"q", text:"¿Qué enzima participa en la ruptura de la Fructosa-1,6-bisfosfato?", choices:["Aldolasa","Hexocinasa","Piruvato cinasa","GAPDH"], correct:0, err:"La Aldolasa es la encargada de romper la molécula de 6 carbonos en dos triosas."},
  {type:"place", item:"DHAP", cat:"Molécula", hint:"Coloca Dihidroxiacetona fosfato (DHAP) en la rama de triosas tras la ruptura.", validNodes:[5]},
  {type:"q", text:"¿Qué sucede con el NAD+ durante la reacción catalizada por GAPDH?", choices:["Se convierte en ATP","Acepta electrones y se reduce a NADH","Se convierte en glucosa","Se consume como enzima"], correct:1, err:"El NAD+ es una coenzima que se reduce recibiendo electrones para formar NADH."},
  {type:"place", item:"G3P", cat:"Molécula", hint:"Coloca Gliceraldehído-3-Fosfato (G3P) en la vía de ganancia.", validNodes:[6,12]},
  {type:"q", text:"¿Cuánto ATP se produce en bruto durante la fase de ganancia?", choices:["2 ATP","4 ATP","6 ATP","8 ATP"], correct:1, err:"Se generan 4 ATP en bruto (2 por cada triosa), dejando una ganancia neta de 2 ATP."},
  {type:"place", item:"Piruvato", cat:"Molécula", hint:"Coloca la molécula final de Piruvato en la meta.", validNodes:[11,17]},
  {type:"q", text:"Con oxígeno disponible, ¿cuál es el destino posterior del piruvato?", choices:["Se queda en el citosol","Ingresa a la mitocondria para su oxidación","Se transforma en lactato de inmediato","Se elimina de la célula"], correct:1, err:"En presencia de oxígeno, el piruvato se desplaza a la mitocondria para el ciclo de Krebs."}
];

const labels=[
["GLUCOSA","6 C"],["¿ ?","6 C"],["F6P","fructosa-6-P"],["¿ ?","6 C · 2 P"],["RUPTURA","ALDOLASA"],
["¿ ?","3 C"],["¿ ?","3 C"],["1,3-BPG","3 C · 2×"],["¿ ?","3 C · 2×"],["¿ ?","3 C · 2×"],["¿ ?","3 C · 2×"],["PIRUVATO 1","3 C"],
["¿ ?","3 C"],["¿ ?","3 C · 2×"],["¿ ?","3 C · 2×"],["¿ ?","3 C · 2×"],["¿ ?","3 C · 2×"],["PIRUVATO 2","3 C"]
];

const pos=[[380,82],[380,145],[380,208],[380,271],[380,330],[210,455],[210,535],[210,615],[210,695],[210,775],[210,835],[210,895],[550,455],[550,535],[550,615],[550,695],[550,775],[550,855]];
const baseEnzymes=[["Aldolasa",475,330]];
let placedCards=new Map();

let state={name:"",step:0,correct:0,bonus:0,pearls:0,start:0,timer:null,atp:0,nadh:0,waitingForNodeClick:false};
const $=id=>document.getElementById(id);
const fmt=s=>String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0");

function draw(){
  const g=$("nodes");g.innerHTML="";
  labels.forEach((a,i)=>{
    let [x,y]=pos[i],group=document.createElementNS("http://www.w3.org/2000/svg","g");
    group.setAttribute("class","node "+(i<state.pearls?"done ":"")+(i===state.pearls?"current ":"")+(i===4||i>=11?"meta":""));
    
    let c=document.createElementNS("http://www.w3.org/2000/svg","circle");
    c.setAttribute("class","pearl");
    c.setAttribute("cx",x);c.setAttribute("cy",y);
    c.setAttribute("r",(i===4||i>=11)?32:27);
    group.appendChild(c);
    
    let displayText = placedCards.has("node_"+i) ? placedCards.get("node_"+i) : a[0];
    let t=document.createElementNS("http://www.w3.org/2000/svg","text");
    t.setAttribute("x",x);t.setAttribute("y",y-5);
    t.textContent=displayText;
    group.appendChild(t);
    
    let s=document.createElementNS("http://www.w3.org/2000/svg","text");
    s.setAttribute("class","small");
    s.setAttribute("x",x);s.setAttribute("y",y+12);
    s.textContent=a[1];
    group.appendChild(s);
    
    group.addEventListener("click",()=>{
      if(state.waitingForNodeClick) handleNodePlacement(i);
    });
    g.appendChild(group);
  });

  const eg=$("enzymes");eg.innerHTML="";
  baseEnzymes.forEach(e=>{
    let t=document.createElementNS("http://www.w3.org/2000/svg","text");
    t.setAttribute("class","enzyme");
    t.setAttribute("x",e[1]);t.setAttribute("y",e[2]);
    t.textContent=e[0];
    eg.appendChild(t);
  });

  const tk=$("token");tk.innerHTML="";
  let idx=Math.min(state.pearls,17),[x,y]=pos[idx];
  let c=document.createElementNS("http://www.w3.org/2000/svg","circle");
  c.setAttribute("class","token");
  c.setAttribute("cx",x);c.setAttribute("cy",y-43);
  c.setAttribute("r",12);
  tk.appendChild(c);
  
  let t=document.createElementNS("http://www.w3.org/2000/svg","text");
  t.setAttribute("class","tokenText");
  t.setAttribute("x",x);t.setAttribute("y",y-43);
  t.textContent="TÚ";
  tk.appendChild(t);
}

function stats(){
  $("pearls").textContent=state.pearls;
  $('atp').textContent=state.atp;
  $('nadh').textContent=state.nadh;
}

function renderCurrentStep(){
  if(state.step>=sequence.length){
    $("dock").classList.remove("active");
    finish();
    return;
  }
  
  let item = sequence[state.step];
  $("dockFeedback").textContent="";
  $("dockNextBtn").style.display="none";
  $("dock").classList.add("active");
  
  if(item.type==="q"){
    state.waitingForNodeClick=false;
    $("dockIcon").textContent="🧪";
    $("dockTitle").textContent="Desafío Teórico";
    $("dockSub").textContent="Pregunta "+(state.step+1)+" de "+sequence.length;
    $("dockText").textContent=item.text;
    
    let box=$("dockChoices");box.innerHTML="";
    item.choices.forEach((c,i)=>{
      let b=document.createElement("button");
      b.className="choice";b.type="button";b.textContent=c;
      b.addEventListener("click",()=>answerQuestion(i,b,item));
      box.appendChild(b);
    });
  } else if(item.type==="place"){
    state.waitingForNodeClick=true;
    $("dockIcon").textContent="🧩";
    $("dockTitle").textContent="Reto de Colocación";
    $("dockSub").textContent="Identifica la posición en el mapa central";
    $("dockText").textContent="Coloca "+item.item+" ("+item.cat+")\n"+item.hint;
    $("dockChoices").innerHTML="<div style='font-size:12px;color:var(--accent);font-weight:bold;margin:8px 0'>👇 Toca una perla/estación en el mapa central para colocarla.</div>";
  }
}

function answerQuestion(idx, btn, item){
  [...document.querySelectorAll(".choice")].forEach(x=>x.disabled=true);
  let ok = idx===item.correct;
  btn.classList.add(ok?"ok":"no");
  
  if(ok){
    state.correct++;
    state.pearls=Math.min(18, state.pearls+1);
    $("dockFeedback").innerHTML="<span style='color:var(--gain)'>✓ ¡Correcto! +1 Perla. El avatar avanza.</span>";
    if(state.pearls>=4) state.atp=2;
    if(state.pearls>=10) state.atp=4;
    stats(); draw();
  } else {
    $("dockFeedback").innerHTML="<span style='color:var(--bad)'>✗ "+item.err+"</span>";
  }
  $("dockNextBtn").style.display="block";
}

function handleNodePlacement(nodeIdx){
  let item = sequence[state.step];
  if(!item || item.type!=="place") return;
  
  if(item.validNodes.includes(nodeIdx)){
    placedCards.set("node_"+nodeIdx, item.item);
    state.bonus++;
    state.pearls=Math.min(18, state.pearls+1);
    state.waitingForNodeClick=false;
    $("dockFeedback").innerHTML="<span style='color:var(--gain)'>✨ ¡Excelente! "+item.item+" colocado correctamente. +1 perla.</span>";
    stats(); draw();
    $("dockNextBtn").style.display="block";
  } else {
    $("dockFeedback").innerHTML="<span style='color:var(--bad)'>↺ Esa no es la estación correspondiente. Inténtalo nuevamente tocando otro nodo del mapa.</span>";
  }
}

$("dockNextBtn").addEventListener("click",()=>{
  state.step++;
  renderCurrentStep();
});

function start(){
  let n=$("name").value.trim();
  if(!n){$("name").focus();return;}
  state.name=n;
  state.start=Date.now();
  $("start").style.display="none";
  $("game").style.display="block";
  $("student").textContent="Biomanauta: "+n;
  draw();
  stats();
  state.timer=setInterval(()=>$("time").textContent=fmt(Math.floor((Date.now()-state.start)/1000)),1000);
  setTimeout(renderCurrentStep, 400);
}

function finish(){
  if($("final").style.display==="block")return;
  clearInterval(state.timer);
  $("game").style.display="none";
  $("final").style.display="block";
  let sec=Math.floor((Date.now()-state.start)/1000);
  $("finalStudent").textContent="Jugador: "+state.name;
  $("finalTime").textContent=fmt(sec);
  $("finalPearls").textContent=state.pearls;
  $("finalCorrect").textContent=state.correct;
  $("finalBonus").textContent=state.bonus;
}

function canvaSVG(){
  return `<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="1500" viewBox="0 0 1200 1500"><rect width="1200" height="1500" fill="#faf9f5"/><text x="600" y="55" text-anchor="middle" font-family="Arial" font-size="28" font-weight="700" fill="#183247">CARRERA DE LA GLUCÓLISIS · PLANTILLA CANVA</text><path d="M600 140V530" fill="none" stroke="#c5cfd6" stroke-width="12" stroke-linecap="round"/><path d="M600 530C470 610 330 620 330 730V1370" fill="none" stroke="#c5cfd6" stroke-width="12" stroke-linecap="round"/><path d="M600 530C730 610 870 620 870 730V1370" fill="none" stroke="#c5cfd6" stroke-width="12" stroke-linecap="round"/></svg>`;
}

$("startBtn").addEventListener("click",start);
$("name").addEventListener("keydown",e=>{if(e.key==="Enter")start()});
$("restart").addEventListener("click",()=>location.reload());
$("canvaBtn").addEventListener("click",()=>{
  let a=document.createElement("a");
  a.href=URL.createObjectURL(new Blob([canvaSVG()],{type:"image/svg+xml"}));
  a.download="plantilla_canva_glucolisis.svg";
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
});
</script>
</body>
</html>
